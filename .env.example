# ==============================================================================
# CONFIGURACIÓN DE MADYPACK - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copie este archivo a `.env` y ajuste los valores según corresponda.
# NUNCA suba el archivo `.env` con credenciales reales a control de versiones.

# --- Aplicación y Logging ---
APP_TITLE="Madypack"
LOG_LEVEL="INFO"
ENV="development" # Options: development, production

# --- Integración con CRM Chatwoot ---
CHATWOOT_URL="http://localhost:3000"
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_API_TOKEN=""

# --- Motor de Precios e Índices IPC ---
BOLSA_SOLAP_CM=3.5
IPC_DATA_PATH="data/ipc.yml"

# --- Integración con ERP Xubio v1.1 ---
XUBIO_PROVIDER="xubio" # Options: xubio (API v1.1 real), null (mock en memoria)
XUBIO_CLIENT_ID=""
XUBIO_SECRET_ID=""
XUBIO_API_URL="https://xubio.com/API/1.1"
